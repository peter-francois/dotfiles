{
  "env": {
    "IMPECCABLE_NO_TELEMETRY": "1"
  },
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.development)",
      "Read(~/.ssh/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "mcp__claude_ai_Linear__delete_*",
      "mcp__claude_ai_Linear__update_*",
      "mcp__claude_ai_Linear__merge_*",
      "mcp__claude_ai_Linear__share_*",
      "mcp__claude_ai_Linear__unshare_*",
      "mcp__claude_ai_Linear__submit_*"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "context7@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
