[user]
	name = Peter Francois
	email = contact@peterfrancois.dev
	signingkey = /home/peter/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[core]
	autocrlf = input
[pull]
	rebase = true
[rebase]
	autoStash = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
